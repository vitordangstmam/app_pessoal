# Copie este arquivo para .env.local (uso local) e cadastre as MESMAS variáveis na Vercel.
# Nunca suba o .env.local para o GitHub.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "anon" (ou "publishable"). É pública por desenho; quem protege os dados é o RLS do banco.
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-chave-anon-aqui

# Anthropic: console.anthropic.com > API Keys. Fica só no servidor (sem NEXT_PUBLIC).
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: modelo do assistente. Padrão: claude-sonnet-5-5
# CLAUDE_MODEL=claude-sonnet-5-5

# Recomendado: só este e-mail pode usar o assistente (o mesmo do seu usuário no Supabase)
ALLOWED_EMAIL=seu-email@exemplo.com
